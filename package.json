{
  "name": "sap-po-test-harness",
  "version": "1.0.0",
  "description": "SAP PI/PO & SAP Integration Suite Automated Test, Parity & Stress-Test Harness (AetherFlow)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "aetherflow": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node ./dist/cli/index.js",
    "dev": "tsx ./src/cli/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sap",
    "sap-pipo",
    "sap-pi",
    "sap-po",
    "sap-integration-suite",
    "cpi",
    "test-harness",
    "parity-testing",
    "stress-testing",
    "performance-benchmarking"
  ],
  "author": "serudanth",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "adm-zip": "^0.6.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "fast-xml-parser": "^5.0.8",
    "ora": "^8.2.0",
    "picocolors": "^1.1.1",
    "undici": "^7.4.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.13.10",
    "@vitest/coverage-v8": "^3.0.8",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.8"
  }
}
